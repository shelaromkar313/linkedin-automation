# ============================================================
# LINKEDIN OUTREACH ENGINE CONFIGURATION
# ============================================================

# 1. LinkedIn Authentication
# Option A: Paste your session cookie "li_at" from browser DevTools (Application -> Cookies -> linkedin.com -> li_at)
LINKEDIN_LI_AT=AQEDA...YourLiAtCookieHere

# Option B: Path to saved storage state JSON (generated automatically if logging in interactively)
LINKEDIN_STORAGE_STATE=storage_state.json

# 2. AI Personalization Provider
# Options: "groq" (recommended free), "ollama" (local free), "gemini", "openrouter", "template" (offline free fallback)
LLM_PROVIDER=groq

# API Keys
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIzaSy...
OPENROUTER_API_KEY=sk-or-...
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:latest

# Business / Pitch Context (Brief explanation of your value prop or industry synergy)
BUSINESS_PITCH=Unified Enterprise - IT technology solutions, telecommunications, and custom automation infrastructure

# 3. Safety Guardrails & Anti-Ban Rate Limiting
# Maximum connection requests to send per 24 hours (Free tier limit recommended: 10 - 15)
MAX_DAILY_INVITES=12

# Delay between profile visits in seconds (min / max for randomization)
MIN_ACTION_DELAY_SECONDS=45
MAX_ACTION_DELAY_SECONDS=110

# Headless mode for Playwright: False (recommended for anti-detection), True (for headless servers)
HEADLESS=False

# Database location
DATABASE_PATH=leads.db
